# Put real values in .env.local (preferred) or .env — both are gitignored.

# --- Agents under test (required from Milestone 4 on; see plans/user-tasks/01) ---
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# GEMINI_API_KEY=        # same key under the agent repos' name; either works
LANGSMITH_API_KEY=

# --- Judge (PRD §7). Defaults to a FREE provider (cerebras / llama-3.3-70b) to
#     keep eval runs cheap; never judges its own provider's cases. ---
# JUDGE_PROVIDER=cerebras   # ollama | cerebras | openrouter | mistral | together | anthropic | google
# JUDGE_MODEL=              # override the provider's default model id
# JUDGE_REPEATS=1           # judgments per model_graded assertion; verdict is the
#                           # majority. Default 1 keeps artifacts identical to the
#                           # frozen baselines. Use an ODD number (3 or 5) before
#                           # publishing a number; an even count can tie, and a tie
#                           # is recorded as a failure. See README "Repeated judging".
CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=
# TOGETHER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Agent repo checkouts (defaults assume the sibling layout:
#     ../lang-chain/wanderlearn-field-reporter and ../lang-chain/centenarian-coach-multiagent,
#     relative to this repo; absolute paths also work) ---
# FIELD_REPORTER_REPO=
# COACH_REPO=
# EVAL_AGENT_TIMEOUT_MS=300000   # per-case agent-run timeout

# --- witus-inbox regression alert (approved integration; inert until provisioned
#     via plans/user-tasks/03 — wired in Milestone 5) ---
# INBOX_INGEST_URL=
# INBOX_SOURCE_SLUG=agent-evals
# INBOX_INGEST_SECRET=
